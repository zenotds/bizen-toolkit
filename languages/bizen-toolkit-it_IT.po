msgstr "Plugin richiesti non attivi: %s"

#: modules/menu-enhancer/module.php
msgid "Menu Management Enhancer"
msgstr "Menu Management Enhancer"

#: modules/menu-enhancer/module.php
msgid "Expand/collapse menu trees, jump between top-level items, and highlight item groups in Appearance → Menus."
msgstr "Espandi/comprimi i menu, naviga tra le voci principali ed evidenzia i gruppi di voci in Aspetto → Menu."

#: modules/cf7-html-editor/module.php
msgid "HTML Editor for CF7"
msgstr "HTML Editor per CF7"

#: modules/cf7-html-editor/module.php
msgid "Adds a CodeMirror HTML editor, test mode, redirect after submit, GA/GTM events, auto-hide message, and more to Contact Form 7."
msgstr "Aggiunge un editor HTML CodeMirror, modalità test, reindirizzamento post-invio, eventi GA/GTM, nascondimento automatico del messaggio e altro a Contact Form 7."

#: modules/cf7-html-editor/class-cf7-coder.php
msgid "Test Mode"
msgstr "Modalità test"

#: modules/cf7-html-editor/class-cf7-coder.php
msgid "Remove Auto tags p and br"
msgstr "Rimuovi i tag automatici p e br"

#: modules/cf7-html-editor/class-cf7-coder.php
msgid "Enable dark theme (Material)"
msgstr "Abilita tema scuro (Material)"

#: modules/cf7-html-editor/class-cf7-coder.php
msgid "Load scripts only on pages with shortcode"
msgstr "Carica gli script solo nelle pagine con lo shortcode"

#: modules/cf7-html-editor/class-cf7-coder.php
msgid "Redirect after submit"
msgstr "Reindirizza dopo l'invio"

#: modules/cf7-html-editor/class-cf7-coder.php
msgid "Open in new tab"
msgstr "Apri in nuova scheda"

#: modules/cf7-html-editor/class-cf7-coder.php
msgid "Force download"
msgstr "Forza il download"

#: modules/cf7-html-editor/class-cf7-coder.php
msgid "Hide form after submit"
msgstr "Nascondi il form dopo l'invio"

#: modules/cf7-html-editor/class-cf7-coder.php
msgid "Remove refill"
msgstr "Rimuovi il ripristino dei campi"

#: modules/cf7-html-editor/class-cf7-coder.php
msgid "Disable submit button while sending"
msgstr "Disabilita il pulsante durante l'invio"

#: modules/cf7-html-editor/class-cf7-coder.php
msgid "Pre-fill fields from URL"
msgstr "Pre-compila i campi dall'URL"

#: modules/cf7-html-editor/class-cf7-coder.php
msgid "GA/GTM Event on submit"
msgstr "Evento GA/GTM all'invio"

#: modules/cf7-html-editor/class-cf7-coder.php
msgid "Scroll to message after submit"
msgstr "Scorri al messaggio dopo l'invio"

#: modules/cf7-html-editor/class-cf7-coder.php
msgid "Auto-hide success message"
msgstr "Nascondi automaticamente il messaggio di successo"

#: modules/cf7-html-editor/class-cf7-coder.php
msgid "seconds"
msgstr "secondi"

#: modules/cf7-html-editor/class-cf7-coder.php
msgid "Sending..."
msgstr "Invio in corso..."

#: modules/cf7-email-template/module.php
msgid "HTML Template for CF7"
msgstr "HTML Template per CF7"

#: modules/cf7-email-template/module.php
msgid "Wraps Contact Form 7 emails in a custom HTML header/footer template with a live Ace editor preview."
msgstr "Racchiude le email di Contact Form 7 in un template HTML personalizzato (header/footer) con anteprima live nell'editor Ace."

#: modules/acfml-sync-fix/module.php
msgid "Disable Sync Repeater for ACFML"
msgstr "Disabilita Sync Repeater per ACFML"

#: modules/acfml-sync-fix/module.php
msgid "Disables the ACFML repeater sync checkbox and its stored option — prevents accidental field sync across languages."
msgstr "Disabilita il checkbox di sincronizzazione repeater di ACFML e la relativa opzione salvata — previene sincronizzazioni accidentali dei campi tra le lingue."

#: modules/disable-flamingo-addressbook/module.php
msgid "Disable Flamingo Addressbook"
msgstr "Disabilita Rubrica Flamingo"

#: modules/disable-flamingo-addressbook/module.php
msgid "Prevents Flamingo from saving any data to its address book — form submissions are still stored in the inbound messages log."
msgstr "Impedisce a Flamingo di salvare qualsiasi dato nella sua rubrica — gli invii dei form restano comunque registrati nel log dei messaggi in entrata."

#: modules/disable-comments/module.php
msgid "Disable Comments"
msgstr "Disabilita Commenti"

#: modules/disable-comments/module.php
msgid "Disables the comment system site-wide — closes comments on all posts and pages (new and existing), hides existing ones, and removes the Comments menu and Discussion settings from the admin."
msgstr "Disabilita il sistema di commenti su tutto il sito — chiude i commenti su tutti gli articoli e le pagine (nuovi ed esistenti), nasconde quelli già presenti e rimuove il menu Commenti e le impostazioni Discussione dall’amministrazione."

#: modules/disable-comments/module.php
msgid "Comments are closed."
msgstr "I commenti sono chiusi."

#: modules/svg-flatten/module.php
msgid "Flatten SVG on Upload"
msgstr "Appiattisci SVG all’Upload"

#: modules/svg-flatten/module.php
msgid "Rewrites uploaded SVGs so they can be inlined side by side — the style block is dropped, its declarations move onto the elements as fill/stroke attributes, and ids are namespaced per file."
msgstr "Riscrive gli SVG caricati perché possano essere inlineati fianco a fianco — il blocco style viene rimosso, le sue dichiarazioni passano sugli elementi come attributi fill/stroke e gli id vengono prefissati per file."

